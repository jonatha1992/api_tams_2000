{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: install dependencies",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/python_service"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: run API",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/python_service"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
